{
  // Mafia Dealer: static app + online rooms. Local: `npm run dev` (vite + workerd). Deploy: see ONLINE_PROGRESS.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mafia-dealer",
  "main": "worker/index.js",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/parties/*"]
  },
  "durable_objects": { "bindings": [{ "name": "Room", "class_name": "Room" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Only needed for Google sign-in. Replace database_id after `npx wrangler d1 create mafia-auth`.
  "d1_databases": [{ "binding": "DB", "database_name": "mafia-auth", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "observability": { "enabled": true }
}
