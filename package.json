{
  "name": "mafia-dealer-react",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NO_WORKER=1 vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=lcov --coverage.reporter=text-summary",
    "coverage:new": "node scripts/new-code-coverage.mjs",
    "test:e2e": "node e2e/narrator.e2e.mjs",
    "test:e2e:online": "node e2e/online.e2e.mjs",
    "db:migrate:local": "wrangler d1 migrations apply mafia-auth --local",
    "db:migrate": "wrangler d1 migrations apply mafia-auth --remote",
    "deploy": "vite build && wrangler deploy",
    "build:worker": "vite build"
  },
  "dependencies": {
    "better-auth": "^1.7.12",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.25",
    "kokoro-js": "^1.2.1",
    "lucide-react": "^0.555.0",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.4.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.10.31",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "vite": "^6.0.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "miniflare": {
      "undici": "^7.30.1"
    }
  }
}
